# FRR daemons enabled in the CGR lab image
bgpd=yes
ospfd=yes
ospf6d=yes
ripd=no
ripngd=no
isisd=yes
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=yes
fabricd=no
vrrpd=yes
pathd=no

vtysh_enable=yes
# 'datacenter' defaults (as on Cumulus Linux): eBGP works without a policy, faster timers
frr_profile="datacenter"
zebra_options="  -A 127.0.0.1 -s 90000000"
mgmtd_options="  -A 127.0.0.1"
bgpd_options="   -A 127.0.0.1"
ospfd_options="  -A 127.0.0.1"
ospf6d_options=" -A ::1"
isisd_options="  -A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"
vrrpd_options="  -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
