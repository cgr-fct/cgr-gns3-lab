# ISP1 (AS 65101) - pre-configured by the instructor, do not change
auto lo
iface lo inet loopback
    address 10.255.101.1/32
    address 198.18.1.1/24

auto swp1
iface swp1
    alias to customer e1
    address 198.51.100.1/30

auto swp2
iface swp2
    alias peering with isp2
    address 198.51.100.9/30
